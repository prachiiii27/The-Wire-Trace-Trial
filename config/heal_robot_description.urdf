  <ros2_control name="cobot_ros2_control" type="system">
    <hardware>
      <plugin>addverb_cobot/CobotHWInterface</plugin>
      <param name="robot_name">&quot;heal&quot;</param>
      <param name="safety_type">1.0</param>
      <param name="payload_status">1</param>
      <param name="payload_mass">1.4</param>
      <param name="payload_comx">0.0</param>
      <param name="payload_comy">0.0</param>
      <param name="payload_comz">-0.14&quot;</param>
      <param name="payload_ixx">1e-05</param>
      <param name="payload_iyy">1e-05</param>
      <param name="payload_izz">1e-05</param>
      <param name="payload_ixy">0.0</param>
      <param name="payload_ixz">0.0</param>
      <param name="payload_iyz">0.0</param>
      <param name="gripper_type">1.0</param>
      <param name="ft_type">0.0</param>
      <param name="ft_rot_r11">1.0</param>
      <param name="ft_rot_r12">0.0</param>
      <param name="ft_rot_r13">0.0</param>
      <param name="ft_rot_r21">0.0</param>
      <param name="ft_rot_r22">1.0</param>
      <param name="ft_rot_r23">0.0</param>
      <param name="ft_rot_r31">0.0</param>
      <param name="ft_rot_r32">0.0</param>
      <param name="ft_rot_r33">1.0</param>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
